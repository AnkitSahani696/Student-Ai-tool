<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

  <!-- Title Bar -->
  <LinearLayout
      android:id="@+id/titleBar"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="@drawable/bg_purple_gradient"
      android:elevation="4dp"
      android:orientation="vertical"
      android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Spell Check Results"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Stats -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

      <TextView
          android:id="@+id/tvStats"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="Total Words: 0\nErrors: 0"
          android:textColor="@android:color/white"
          android:textSize="14sp" />

      <TextView
          android:id="@+id/tvAccuracy"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:background="@drawable/accuracy_badge"
          android:padding="8dp"
          android:text="100%"
          android:textColor="@android:color/white"
          android:textSize="16sp"
          android:textStyle="bold" />

    </LinearLayout>

  </LinearLayout>

  <!-- Main Content -->
  <ScrollView
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_above="@id/bottomPanel"
      android:layout_below="@id/titleBar"
      android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

      <!-- Original Text Section -->
      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="Original Text with Errors Highlighted:"
          android:textColor="@color/text_primary"
          android:textSize="16sp"
          android:textStyle="bold" />

      <com.google.android.material.card.MaterialCardView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          app:cardCornerRadius="12dp"
          app:cardElevation="2dp">

        <TextView
            android:id="@+id/tvOriginalText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:padding="16dp"
            android:text="Text will appear here..."
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

      </com.google.android.material.card.MaterialCardView>

      <!-- Errors List Section -->
      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="24dp"
          android:text="Spelling Errors:"
          android:textColor="@color/text_primary"
          android:textSize="16sp"
          android:textStyle="bold" />

      <TextView
          android:id="@+id/tvNoErrors"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:background="@drawable/success_background"
          android:drawableStart="@drawable/ic_check"
          android:drawablePadding="8dp"
          android:padding="16dp"
          android:text="✨ No spelling errors found!\nYour text is perfect."
          android:textColor="@color/success"
          android:textSize="16sp"
          android:visibility="gone" />

      <androidx.recyclerview.widget.RecyclerView
          android:id="@+id/recyclerViewErrors"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:nestedScrollingEnabled="false" />

    </LinearLayout>

  </ScrollView>

  <!-- Progress Bar -->
  <ProgressBar
      android:id="@+id/progressBar"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_centerInParent="true"
      android:indeterminateTint="@color/purple_500"
      android:visibility="gone" />

  <!-- Bottom Panel -->
  <LinearLayout
      android:id="@+id/bottomPanel"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_alignParentBottom="true"
      android:background="@color/white"
      android:elevation="8dp"
      android:orientation="vertical"
      android:padding="16dp">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnApplyCorrections"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Apply Corrections"
        android:textSize="16sp"
        app:cornerRadius="12dp"
        app:icon="@drawable/ic_check"
        app:iconGravity="textStart" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBackToHome"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:text="Back to Home"
        android:textSize="16sp"
        app:cornerRadius="12dp" />

  </LinearLayout>

</RelativeLayout>